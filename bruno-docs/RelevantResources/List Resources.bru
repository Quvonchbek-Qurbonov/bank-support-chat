meta {
  name: Get Relevant Resources
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/relevants
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "question": "How much does a Humo card cost?"
  }
}

docs {
  # Get Relevant Resources

  Retrieves the most relevant resource for a user's question using the RAG retrieval pipeline.

  ## Request Body

  The request body must contain:

  ```json
  {
    "question": "string"
  }