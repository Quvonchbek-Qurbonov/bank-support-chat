QDRANT_COLLECTION=agrobank_pages

EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
TOP_K=20
MIN_RETRIEVAL_SCORE=0.20


